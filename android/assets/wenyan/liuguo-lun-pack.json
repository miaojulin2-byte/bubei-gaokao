  "sentences": [
    {
      "id": "liuguo-lun-s01",
      "order": 1,
      "section": "第1段",
      "text": "六国破灭，非兵不利，战不善，弊在赂秦。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s02",
      "order": 2,
      "section": "第1段",
      "text": "赂秦而力亏，破灭之道也。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s03",
      "order": 3,
      "section": "第1段",
      "text": "或曰：六国互丧，率赂秦耶？",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s04",
      "order": 4,
      "section": "第1段",
      "text": "曰：不赂者以赂者丧。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s05",
      "order": 5,
      "section": "第1段",
      "text": "盖失强援，不能独完。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s06",
      "order": 6,
      "section": "第1段",
      "text": "故曰：弊在赂秦也。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s07",
      "order": 7,
      "section": "第2段",
      "text": "秦以攻取之外，小则获邑，大则得城。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s08",
      "order": 8,
      "section": "第2段",
      "text": "较秦之所得，与战胜而得者，其实百倍；",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s09",
      "order": 9,
      "section": "第2段",
      "text": "诸侯之所亡，与战败而亡者，其实亦百倍。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s10",
      "order": 10,
      "section": "第2段",
      "text": "则秦之所大欲，诸侯之所大患，固不在战矣。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s11",
      "order": 11,
      "section": "第2段",
      "text": "思厥先祖父，暴霜露，斩荆棘，以有尺寸之地。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s12",
      "order": 12,
      "section": "第2段",
      "text": "子孙视之不甚惜，举以予人，如弃草芥。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s13",
      "order": 13,
      "section": "第2段",
      "text": "今日割五城，明日割十城，然后得一夕安寝。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s14",
      "order": 14,
      "section": "第2段",
      "text": "起视四境，而秦兵又至矣。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s15",
      "order": 15,
      "section": "第2段",
      "text": "然则诸侯之地有限，暴秦之欲无厌，奉之弥繁，侵之愈急。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s16",
      "order": 16,
      "section": "第2段",
      "text": "故不战而强弱胜负已判矣。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s17",
      "order": 17,
      "section": "第2段",
      "text": "至于颠覆，理固宜然。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s18",
      "order": 18,
      "section": "第2段",
      "text": "古人云：“以地事秦，犹抱薪救火，薪不尽，火不灭。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s19",
      "order": 19,
      "section": "第2段",
      "text": "此言得之。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s20",
      "order": 20,
      "section": "第3段",
      "text": "齐人未尝赂秦，终继五国迁灭，何哉？",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s21",
      "order": 21,
      "section": "第3段",
      "text": "与嬴而不助五国也。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s22",
      "order": 22,
      "section": "第3段",
      "text": "五国既丧，齐亦不免矣。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s23",
      "order": 23,
      "section": "第3段",
      "text": "燕赵之君，始有远略，能守其土，义不赂秦。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s24",
      "order": 24,
      "section": "第3段",
      "text": "是故燕虽小国而后亡，斯用兵之效也。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s25",
      "order": 25,
      "section": "第3段",
      "text": "至丹以荆卿为计，始速祸焉。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s26",
      "order": 26,
      "section": "第3段",
      "text": "赵尝五战于秦，二败而三胜。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s27",
      "order": 27,
      "section": "第3段",
      "text": "后秦击赵者再，李牧连却之。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s28",
      "order": 28,
      "section": "第3段",
      "text": "洎牧以谗诛，邯郸为郡，惜其用武而不终也。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s29",
      "order": 29,
      "section": "第3段",
      "text": "且燕赵处秦革灭殆尽之际，可谓智力孤危，战败而亡，诚不得已。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s30",
      "order": 30,
      "section": "第3段",
      "text": "向使三国各爱其地，齐人勿附于秦，刺客不行，良将犹在，则胜负之数，存亡之理，当与秦相较，或未易量。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s31",
      "order": 31,
      "section": "第4段",
      "text": "呜呼！",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s32",
      "order": 32,
      "section": "第4段",
      "text": "以赂秦之地封天下之谋臣，以事秦之心礼天下之奇才，并力西向，则吾恐秦人食之不得下咽也。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s33",
      "order": 33,
      "section": "第4段",
      "text": "悲夫！",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s34",
      "order": 34,
      "section": "第4段",
      "text": "有如此之势，而为秦人积威之所劫，日削月割，以趋于亡。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s35",
      "order": 35,
      "section": "第4段",
      "text": "为国者无使为积威之所劫哉！",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s36",
      "order": 36,
      "section": "第5段",
      "text": "夫六国与秦皆诸侯，其势弱于秦，而犹有可以不赂而胜之之势。",
      "focus": ""
    },
    {
      "id": "liuguo-lun-s37",
      "order": 37,
      "section": "第5段",
      "text": "苟以天下之大，下而从六国破亡之故事，是又在六国下矣。",
      "focus": ""
    }
  ],
