  "sentences": [
    {
      "id": "quanxue-s01",
      "order": 1,
      "section": "第一段",
      "text": "君子曰：学不可以已。",
      "focus": "学习不可以停止。"
    },
    {
      "id": "quanxue-s02",
      "order": 2,
      "section": "第一段",
      "text": "青，取之于蓝，而青于蓝；冰，水为之，而寒于水。",
      "focus": "靛青从蓝草中提取，却比蓝草更青；冰由水凝结，却比水更寒。"
    },
    {
      "id": "quanxue-s03",
      "order": 3,
      "section": "第一段",
      "text": "木直中绳，輮以为轮，其曲中规。",
      "focus": "木材直得合乎墨线，用火烤弯做成车轮，弧度合乎圆规。"
    },
    {
      "id": "quanxue-s04",
      "order": 4,
      "section": "第一段",
      "text": "虽有槁暴，不复挺者，輮使之然也。",
      "focus": "即使又晒干，也不再挺直，是火烤弯曲使它这样。"
    },
    {
      "id": "quanxue-s05",
      "order": 5,
      "section": "第一段",
      "text": "故木受绳则直，金就砺则利，君子博学而日参省乎己，则知明而行无过矣。",
      "focus": "木材经墨线量过就直，刀剑在磨刀石上磨就锋利；君子广泛学习并每天检验反省，就智慧明达、行为无过。"
    },
    {
      "id": "quanxue-s06",
      "order": 6,
      "section": "第二段",
      "text": "吾尝终日而思矣，不如须臾之所学也；吾尝跂而望矣，不如登高之博见也。",
      "focus": "整天空想不如片刻学习；踮脚远望不如登高看得广。"
    },
    {
      "id": "quanxue-s07",
      "order": 7,
      "section": "第二段",
      "text": "登高而招，臂非加长也，而见者远；顺风而呼，声非加疾也，而闻者彰。",
      "focus": "登高招手，手臂没有加长，远处的人却看得见；顺风呼喊，声音没有更强，听的人却更清楚。"
    },
    {
      "id": "quanxue-s08",
      "order": 8,
      "section": "第二段",
      "text": "假舆马者，非利足也，而致千里；假舟楫者，非能水也，而绝江河。",
      "focus": "借助车马的人不是脚快，却能到千里；借助船只的人不是会游泳，却能横渡江河。"
    },
    {
      "id": "quanxue-s09",
      "order": 9,
      "section": "第二段",
      "text": "君子生非异也，善假于物也。",
      "focus": "君子天性同一般人没有差别，只是善于借助外物。"
    },
    {
      "id": "quanxue-s10",
      "order": 10,
      "section": "第三段",
      "text": "积土成山，风雨兴焉；积水成渊，蛟龙生焉；积善成德，而神明自得，圣心备焉。",
      "focus": "积累土成山，风雨从那里兴起；积水成渊，蛟龙在那里生长；积累善行养成品德，智慧自然获得，圣心具备。"
    },
    {
      "id": "quanxue-s11",
      "order": 11,
      "section": "第三段",
      "text": "故不积跬步，无以至千里；不积小流，无以成江海。",
      "focus": "不积累半步，就无法到达千里；不积累细流，就无法汇成江海。"
    },
    {
      "id": "quanxue-s12",
      "order": 12,
      "section": "第三段",
      "text": "骐骥一跃，不能十步；驽马十驾，功在不舍。",
      "focus": "骏马一跃不过十步；劣马拉车走十天，功效在于不停止。"
    },
    {
      "id": "quanxue-s13",
      "order": 13,
      "section": "第三段",
      "text": "锲而舍之，朽木不折；锲而不舍，金石可镂。",
      "focus": "刻一下就放弃，朽木也折不断；坚持刻，金石也能雕成。"
    },
    {
      "id": "quanxue-s14",
      "order": 14,
      "section": "第三段",
      "text": "蚓无爪牙之利，筋骨之强，上食埃土，下饮黄泉，用心一也。",
      "focus": "蚯蚓没有锋利的爪牙、强健的筋骨，却能上吃泥土、下饮地泉，因为用心专一。"
    },
    {
      "id": "quanxue-s15",
      "order": 15,
      "section": "第三段",
      "text": "蟹六跪而二螯，非蛇鳝之穴无可寄托者，用心躁也。",
      "focus": "螃蟹有六条腿两只钳，没有蛇鳝的洞穴就无处藏身，因为用心浮躁。"
    }
  ],
