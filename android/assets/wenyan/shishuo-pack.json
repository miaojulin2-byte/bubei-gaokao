  "sentences": [
    {
      "id": "shishuo-s01",
      "order": 1,
      "section": "第一段",
      "text": "古之学者必有师。",
      "focus": "古代求学的人一定有老师。"
    },
    {
      "id": "shishuo-s02",
      "order": 2,
      "section": "第一段",
      "text": "师者，所以传道受业解惑也。",
      "focus": "老师，是用来传授道理、教授学业、解答疑难的人。"
    },
    {
      "id": "shishuo-s03",
      "order": 3,
      "section": "第一段",
      "text": "人非生而知之者，孰能无惑？",
      "focus": "人不是生来就懂得知识和道理的，谁能没有疑难？"
    },
    {
      "id": "shishuo-s04",
      "order": 4,
      "section": "第一段",
      "text": "惑而不从师，其为惑也，终不解矣。",
      "focus": "有了疑难却不跟从老师学习，那些疑难最终不能解决。"
    },
    {
      "id": "shishuo-s05",
      "order": 5,
      "section": "第一段",
      "text": "生乎吾前，其闻道也固先乎吾，吾从而师之；",
      "focus": "出生在我前面的人，他懂得道理本来早于我，我跟随他并把他当作老师；"
    },
    {
      "id": "shishuo-s06",
      "order": 6,
      "section": "第一段",
      "text": "生乎吾后，其闻道也亦先乎吾，吾从而师之。",
      "focus": "出生在我后面的人，他懂得道理也早于我，我跟随他并把他当作老师。"
    },
    {
      "id": "shishuo-s07",
      "order": 7,
      "section": "第一段",
      "text": "吾师道也，夫庸知其年之先后生于吾乎？",
      "focus": "我学习的是道理，哪里用得着管他的年龄比我大还是小呢？"
    },
    {
      "id": "shishuo-s08",
      "order": 8,
      "section": "第一段",
      "text": "是故无贵无贱，无长无少，道之所存，师之所存也。",
      "focus": "因此无论地位高低、年龄大小，道理存在的地方，就是老师存在的地方。"
    },
    {
      "id": "shishuo-s09",
      "order": 9,
      "section": "第二段",
      "text": "嗟乎！",
      "focus": "唉！"
    },
    {
      "id": "shishuo-s10",
      "order": 10,
      "section": "第二段",
      "text": "师道之不传也久矣！",
      "focus": "从师学习的风尚不流传已经很久了！"
    },
    {
      "id": "shishuo-s11",
      "order": 11,
      "section": "第二段",
      "text": "欲人之无惑也难矣！",
      "focus": "想要人们没有疑难就难了！"
    },
    {
      "id": "shishuo-s12",
      "order": 12,
      "section": "第二段",
      "text": "古之圣人，其出人也远矣，犹且从师而问焉；",
      "focus": "古代的圣人，超出一般人很远了，尚且跟从老师请教；"
    },
    {
      "id": "shishuo-s13",
      "order": 13,
      "section": "第二段",
      "text": "今之众人，其下圣人也亦远矣，而耻学于师。",
      "focus": "现在的一般人，低于圣人也很远了，却以向老师学习为耻。"
    },
    {
      "id": "shishuo-s14",
      "order": 14,
      "section": "第二段",
      "text": "是故圣益圣，愚益愚。",
      "focus": "因此圣人更加圣明，愚人更加愚昧。"
    },
    {
      "id": "shishuo-s15",
      "order": 15,
      "section": "第二段",
      "text": "圣人之所以为圣，愚人之所以为愚，其皆出于此乎？",
      "focus": "圣人成为圣人的原因，愚人成为愚人的原因，大概都出于这里吧？"
    },
    {
      "id": "shishuo-s16",
      "order": 16,
      "section": "第二段",
      "text": "爱其子，择师而教之；",
      "focus": "爱自己的孩子，选择老师来教他；"
    },
    {
      "id": "shishuo-s17",
      "order": 17,
      "section": "第二段",
      "text": "于其身也，则耻师焉，惑矣。",
      "focus": "对于他自己，却以从师为耻，真是糊涂啊。"
    },
    {
      "id": "shishuo-s18",
      "order": 18,
      "section": "第二段",
      "text": "彼童子之师，授之书而习其句读者，非吾所谓传其道解其惑者也。",
      "focus": "那些孩子的老师，教他读书、学习断句的，不是我所说的传授道理、解答疑难的人。"
    },
    {
      "id": "shishuo-s19",
      "order": 19,
      "section": "第二段",
      "text": "句读之不知，惑之不解，或师焉，或不焉，小学而大遗，吾未见其明也。",
      "focus": "不懂断句，不能解决疑难，有的从师，有的不从师，小的学了大的却丢了，我看不出他明智。"
    },
    {
      "id": "shishuo-s20",
      "order": 20,
      "section": "第三段",
      "text": "巫医乐师百工之人，不耻相师。",
      "focus": "巫医、乐师和各种工匠，不以互相学习为耻。"
    },
    {
      "id": "shishuo-s21",
      "order": 21,
      "section": "第三段",
      "text": "士大夫之族，曰师曰弟子云者，则群聚而笑之。",
      "focus": "士大夫这一类人，一说到“老师”“弟子”这样的话，就聚在一起嘲笑他。"
    },
    {
      "id": "shishuo-s22",
      "order": 22,
      "section": "第三段",
      "text": "问之，则曰：“彼与彼年相若也，道相似也，位卑则足羞，官盛则近谀。”",
      "focus": "问他们，就说：“他和他年龄差不多，道术也相似，以地位低的人为师就感到羞耻，以官职高的人为师就近于谄媚。”"
    },
    {
      "id": "shishuo-s23",
      "order": 23,
      "section": "第三段",
      "text": "呜呼！",
      "focus": "唉！"
    },
    {
      "id": "shishuo-s24",
      "order": 24,
      "section": "第三段",
      "text": "师道之不复，可知矣。",
      "focus": "从师学习的风尚不能恢复，可以知道了。"
    },
    {
      "id": "shishuo-s25",
      "order": 25,
      "section": "第三段",
      "text": "巫医乐师百工之人，君子不齿，今其智乃反不能及，其可怪也欤！",
      "focus": "巫医、乐师和各种工匠，士大夫看不起他们，现在士大夫的见识竟然反而比不上他们，这真奇怪啊！"
    },
    {
      "id": "shishuo-s26",
      "order": 26,
      "section": "第四段",
      "text": "圣人无常师。",
      "focus": "圣人没有固定的老师。"
    },
    {
      "id": "shishuo-s27",
      "order": 27,
      "section": "第四段",
      "text": "孔子师郯子、苌弘、师襄、老聃。",
      "focus": "孔子以郯子、苌弘、师襄、老聃为师。"
    },
    {
      "id": "shishuo-s28",
      "order": 28,
      "section": "第四段",
      "text": "郯子之徒，其贤不及孔子。",
      "focus": "郯子这些人，他们的贤能比不上孔子。"
    },
    {
      "id": "shishuo-s29",
      "order": 29,
      "section": "第四段",
      "text": "孔子曰：三人行，则必有我师。",
      "focus": "孔子说：三个人一起走，其中一定有可以做我老师的人。"
    },
    {
      "id": "shishuo-s30",
      "order": 30,
      "section": "第四段",
      "text": "是故弟子不必不如师，师不必贤于弟子，闻道有先后，术业有专攻，如是而已。",
      "focus": "因此学生不一定不如老师，老师不一定比学生贤能，懂得道理有先有后，学问技艺各有专门研究，如此罢了。"
    },
    {
      "id": "shishuo-s31",
      "order": 31,
      "section": "第四段",
      "text": "李氏子蟠，年十七，好古文，六艺经传皆通习之，不拘于时，学于余。",
      "focus": "李家的孩子蟠，十七岁，喜欢古文，六经的经文和传文都普遍学习，不受时俗限制，向我学习。"
    },
    {
      "id": "shishuo-s32",
      "order": 32,
      "section": "第四段",
      "text": "余嘉其能行古道，作《师说》以贻之。",
      "focus": "我赞许他能践行古人从师之道，写这篇《师说》来赠送他。"
    }
  ],
