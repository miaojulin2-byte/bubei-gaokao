  "sentences": [
    {
      "id": "chibi-fu-s01",
      "order": 1,
      "section": "第1段",
      "text": "壬戌之秋，七月既望，苏子与客泛舟游于赤壁之下。",
      "focus": ""
    },
    {
      "id": "chibi-fu-s02",
      "order": 2,
      "section": "第1段",
      "text": "清风徐来，水波不兴。",
      "focus": ""
    },
    {
      "id": "chibi-fu-s03",
      "order": 3,
      "section": "第1段",
      "text": "举酒属客，诵明月之诗，歌窈窕之章。",
      "focus": ""
    },
    {
      "id": "chibi-fu-s04",
      "order": 4,
      "section": "第1段",
      "text": "少焉，月出于东山之上，徘徊于斗牛之间。",
      "focus": ""
    },
    {
      "id": "chibi-fu-s05",
      "order": 5,
      "section": "第1段",
      "text": "白露横江，水光接天。",
      "focus": ""
    },
    {
      "id": "chibi-fu-s06",
      "order": 6,
      "section": "第1段",
      "text": "纵一苇之所如，凌万顷之茫然。",
      "focus": ""
    },
    {
      "id": "chibi-fu-s07",
      "order": 7,
      "section": "第1段",
      "text": "浩浩乎如冯虚御风，而不知其所止；",
      "focus": ""
    },
    {
      "id": "chibi-fu-s08",
      "order": 8,
      "section": "第1段",
      "text": "飘飘乎如遗世独立，羽化而登仙。",
      "focus": ""
    },
    {
      "id": "chibi-fu-s09",
      "order": 9,
      "section": "第2段",
      "text": "于是饮酒乐甚，扣舷而歌之。",
      "focus": ""
    },
    {
      "id": "chibi-fu-s10",
      "order": 10,
      "section": "第2段",
      "text": "歌曰：“桂棹兮兰桨，击空明兮溯流光。",
      "focus": ""
    },
    {
      "id": "chibi-fu-s11",
      "order": 11,
      "section": "第2段",
      "text": "渺渺兮予怀，望美人兮天一方。",
      "focus": ""
    },
    {
      "id": "chibi-fu-s12",
      "order": 12,
      "section": "第2段",
      "text": "客有吹洞箫者，倚歌而和之。",
      "focus": ""
    },
    {
      "id": "chibi-fu-s13",
      "order": 13,
      "section": "第2段",
      "text": "其声呜呜然，如怨如慕，如泣如诉，余音袅袅，不绝如缕。",
      "focus": ""
    },
    {
      "id": "chibi-fu-s14",
      "order": 14,
      "section": "第2段",
      "text": "舞幽壑之潜蛟，泣孤舟之嫠妇。",
      "focus": ""
    },
    {
      "id": "chibi-fu-s15",
      "order": 15,
      "section": "第3段",
      "text": "苏子愀然，正襟危坐而问客曰：“何为其然也？",
      "focus": ""
    },
    {
      "id": "chibi-fu-s16",
      "order": 16,
      "section": "第3段",
      "text": "客曰：“‘月明星稀，乌鹊南飞’，此非曹孟德之诗乎？",
      "focus": ""
    },
    {
      "id": "chibi-fu-s17",
      "order": 17,
      "section": "第3段",
      "text": "西望夏口，东望武昌，山川相缪，郁乎苍苍，此非孟德之困于周郎者乎？",
      "focus": ""
    },
    {
      "id": "chibi-fu-s18",
      "order": 18,
      "section": "第3段",
      "text": "方其破荆州，下江陵，顺流而东也，舳舻千里，旌旗蔽空，酾酒临江，横槊赋诗，固一世之雄也，而今安在哉？",
      "focus": ""
    },
    {
      "id": "chibi-fu-s19",
      "order": 19,
      "section": "第3段",
      "text": "况吾与子渔樵于江渚之上，侣鱼虾而友麋鹿，驾一叶之扁舟，举匏樽以相属。",
      "focus": ""
    },
    {
      "id": "chibi-fu-s20",
      "order": 20,
      "section": "第3段",
      "text": "寄蜉蝣于天地，渺沧海之一粟。",
      "focus": ""
    },
    {
      "id": "chibi-fu-s21",
      "order": 21,
      "section": "第3段",
      "text": "哀吾生之须臾，羡长江之无穷。",
      "focus": ""
    },
    {
      "id": "chibi-fu-s22",
      "order": 22,
      "section": "第3段",
      "text": "挟飞仙以遨游，抱明月而长终。",
      "focus": ""
    },
    {
      "id": "chibi-fu-s23",
      "order": 23,
      "section": "第3段",
      "text": "知不可乎骤得，托遗响于悲风。”",
      "focus": ""
    },
    {
      "id": "chibi-fu-s24",
      "order": 24,
      "section": "第4段",
      "text": "苏子曰：“客亦知夫水与月乎？",
      "focus": ""
    },
    {
      "id": "chibi-fu-s25",
      "order": 25,
      "section": "第4段",
      "text": "逝者如斯，而未尝往也；",
      "focus": ""
    },
    {
      "id": "chibi-fu-s26",
      "order": 26,
      "section": "第4段",
      "text": "盈虚者如彼，而卒莫消长也。",
      "focus": ""
    },
    {
      "id": "chibi-fu-s27",
      "order": 27,
      "section": "第4段",
      "text": "盖将自其变者而观之，则天地曾不能以一瞬；",
      "focus": ""
    },
    {
      "id": "chibi-fu-s28",
      "order": 28,
      "section": "第4段",
      "text": "自其不变者而观之，则物与我皆无尽也，而又何羡乎！",
      "focus": ""
    },
    {
      "id": "chibi-fu-s29",
      "order": 29,
      "section": "第4段",
      "text": "且夫天地之间，物各有主，苟非吾之所有，虽一毫而莫取。",
      "focus": ""
    },
    {
      "id": "chibi-fu-s30",
      "order": 30,
      "section": "第4段",
      "text": "惟江上之清风，与山间之明月，耳得之而为声，目遇之而成色，取之无禁，用之不竭，是造物者之无尽藏也，而吾与子之所共适。”",
      "focus": ""
    },
    {
      "id": "chibi-fu-s31",
      "order": 31,
      "section": "第5段",
      "text": "客喜而笑，洗盏更酌。",
      "focus": ""
    },
    {
      "id": "chibi-fu-s32",
      "order": 32,
      "section": "第5段",
      "text": "肴核既尽，杯盘狼籍。",
      "focus": ""
    },
    {
      "id": "chibi-fu-s33",
      "order": 33,
      "section": "第5段",
      "text": "相与枕藉乎舟中，不知东方之既白。",
      "focus": ""
    }
  ],
  "recitation_segments": [
